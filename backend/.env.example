# ---------------------------------------------------------------------------
# Bearly backend configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Required in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
BEARLY_SECRET_KEY=dev-insecure-change-me

# SQLite for local dev. Swap for PostgreSQL with no application changes, e.g.
# BEARLY_DATABASE_URL=postgresql+psycopg://bearly:secret@localhost:5432/bearly
BEARLY_DATABASE_URL=sqlite:///./bearly.db

BEARLY_ENVIRONMENT=development
BEARLY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BEARLY_ACCESS_TOKEN_MINUTES=60
BEARLY_REFRESH_TOKEN_DAYS=14

# --- AI agents -------------------------------------------------------------
# stub      = deterministic, no inference, no credentials (default; app works fully)
# anthropic = call Claude directly from the API process
# tenki     = run the agent inside a Tenki.cloud sandbox microVM (inference still
#             needs ANTHROPIC_API_KEY, injected into the sandbox environment)
BEARLY_AI_PROVIDER=stub

# Model tiering: cheap model for routine analysis, stronger model for planning.
BEARLY_AI_ROUTINE_MODEL=claude-haiku-4-5
BEARLY_AI_PLANNER_MODEL=claude-opus-5
# Chat runs many short turns — keep it on the cheap model unless you need more.
BEARLY_AI_CHAT_MODEL=claude-haiku-4-5
BEARLY_AI_MAX_OUTPUT_TOKENS=1500

# Never exposed to the frontend.
ANTHROPIC_API_KEY=

# Tenki.cloud workspace key (tk_...), only needed when BEARLY_AI_PROVIDER=tenki
TENKI_API_KEY=
BEARLY_TENKI_SANDBOX_TIMEOUT=120

# Cache recommendations for this long when the underlying finances are unchanged.
BEARLY_AI_CACHE_HOURS=24
