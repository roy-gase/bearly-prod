# ---------------------------------------------------------------------------
# Bearly production environment. Copy to .env — NEVER commit the result.
#
#   cp .env.production.example .env
#
# Generate the secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=bearly
POSTGRES_PASSWORD=            # required, no default
POSTGRES_DB=bearly

# --- Security --------------------------------------------------------------
# Minimum 32 characters. Rotating it signs every existing session out.
BEARLY_SECRET_KEY=

# Exact origins, no wildcards. The API refuses to start with "*" in production.
BEARLY_CORS_ORIGINS=https://bearly.example.com
BEARLY_TRUSTED_HOSTS=bearly.example.com,api.bearly.example.com

# Used to build password-reset links, so it must match your public URL.
BEARLY_APP_BASE_URL=https://bearly.example.com

BEARLY_ACCESS_TOKEN_MINUTES=60
BEARLY_REFRESH_TOKEN_DAYS=14
BEARLY_MAX_FAILED_LOGINS=8
BEARLY_LOCKOUT_MINUTES=15

# --- Email (required) ------------------------------------------------------
# Without SMTP, password reset silently does nothing and locked-out users can
# never recover, so the API refuses to boot without it.
BEARLY_SMTP_HOST=
BEARLY_SMTP_PORT=587
BEARLY_SMTP_USER=
BEARLY_SMTP_PASSWORD=
BEARLY_SMTP_FROM=Bearly <no-reply@bearly.example.com>

# --- AI --------------------------------------------------------------------
# stub = no inference, no cost, app fully functional
# anthropic = real chat and agents (requires ANTHROPIC_API_KEY)
BEARLY_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

BEARLY_AI_CHAT_MODEL=claude-haiku-4-5
BEARLY_AI_ROUTINE_MODEL=claude-haiku-4-5
BEARLY_AI_PLANNER_MODEL=claude-opus-5
BEARLY_AI_CACHE_HOURS=24

# --- Runtime ---------------------------------------------------------------
# Each worker holds its own DB pool; keep workers x pool under your Postgres
# max_connections (default 100).
BEARLY_WORKERS=4
