# Leave EMPTY when the API is deployed alongside the frontend (the default:
# vercel.json routes /api to the serverless function, so everything is
# same-origin and no CORS configuration is needed).
#
# Set this only when the API runs on a different host:
#   VITE_API_URL=https://bearly-api.example.com
VITE_API_URL=

# Vercel's Python runtime buffers streaming responses, so the chat asks for one
# buffered reply instead of a token stream. Leave this as "false" on Vercel.
VITE_CHAT_STREAMING=false
