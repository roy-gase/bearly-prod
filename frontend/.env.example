# Local development: leave empty. Vite proxies /api to the backend on port 8000.
#
# Production (Vercel): set this to the deployed API origin, because the API runs
# on a different host. Point the browser straight at it — routing SSE through a
# CDN rewrite risks the proxy buffering the chat stream.
#
#   VITE_API_URL=https://bearly-api.onrender.com
VITE_API_URL=

# Set to "false" only if your host buffers Server-Sent Events. The chat then
# uses a single buffered response instead of streaming.
VITE_CHAT_STREAMING=
